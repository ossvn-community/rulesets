{
  "name": "OSSVN R0 Content - set risk_level target",
  "target": "branch",
  "source_type": "Organization",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "repository_name": {
      "exclude": [],
      "include": [
        "__SET_RISK_LEVEL_R0_BEFORE_ACTIVATION__"
      ]
    },
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "dismiss_stale_reviews_on_push": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    }
  ]
}
