{
  "name": "OSSVN R3 Critical - set risk_level target",
  "target": "branch",
  "source_type": "Organization",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "repository_name": {
      "exclude": [],
      "include": [
        "__SET_RISK_LEVEL_R3_BEFORE_ACTIVATION__"
      ]
    },
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "dismiss_stale_reviews_on_push": true,
        "required_approving_review_count": 2,
        "required_review_thread_resolution": true
      }
    }
  ]
}
